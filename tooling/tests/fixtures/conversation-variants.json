{
  "schemaVersion": 1,
  "variants": [
    { "name": "standard", "path": "/c/example", "semanticContract": "numbered-turn-sections" },
    { "name": "project", "path": "/g/project/example/c/example", "semanticContract": "numbered-turn-sections" },
    { "name": "temporary", "path": "/?temporary-chat=true", "semanticContract": "numbered-turn-sections" },
    { "name": "custom-gpt", "path": "/g/example/c/example", "semanticContract": "numbered-turn-sections" },
    { "name": "work-branch", "path": "/c/example?branch=example", "semanticContract": "numbered-turn-sections" },
    { "name": "public-share", "path": "/share/example", "semanticContract": "numbered-turn-sections" }
